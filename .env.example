# --- Supabase ---------------------------------------------------------------
# Laisser vide pour lancer le dashboard en "mode démo" (mock data, sans auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : utilisée UNIQUEMENT côté serveur par la route webhook
# (/api/webhooks/ingest) pour écrire les données envoyées par Make.com / N8N.
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé avec Make.com / N8N (header "x-havnn-webhook-secret").
HAVNN_WEBHOOK_SECRET=

# --- Relevé quotidien des avis Google (Vercel Cron) -------------------------
# Clé Google Cloud avec « Places API (New) » activée.
GOOGLE_PLACES_API_KEY=
# Secret du cron : Vercel l'envoie automatiquement (Authorization: Bearer …).
CRON_SECRET=
